# Public Supabase browser configuration. These values are safe for the browser;
# data access is protected by row-level security, not by hiding this key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:4173
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Use one TMDB application credential. Never commit the populated .env file.
TMDB_READ_ACCESS_TOKEN=
# TMDB_API_KEY=
